<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SplitBill</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Đặt theme TRƯỚC khi body render để tránh FOUC (nháy sáng rồi mới chuyển tối) — xem
        // CLAUDE.md mục 15 (Dark mode). Đọc localStorage, fallback prefers-color-scheme của hệ điều
        // hành nếu người dùng chưa từng chọn, mặc định light nếu trình duyệt không hỗ trợ cả hai.
        (function () {
            try {
                var saved = localStorage.getItem('sb-theme');
                var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
                // data-bs-theme: vô hại nếu Bootstrap < 5.3 (thuộc tính lạ, bị bỏ qua), nhưng cho
                // Bootstrap 5.3+ tự đổi biến --bs-* của các thành phần chưa được site.css ghi đè
                // riêng (dropdown, modal, close button...).
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) { /* localStorage có thể bị chặn (chế độ ẩn danh nghiêm ngặt) — mặc định light */ }
        })();
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">💰 SplitBill</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Groups/Index">Nhóm của tôi</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        <li class="nav-item">
                            <button type="button" id="sb-theme-toggle" class="btn btn-link nav-link" title="Đổi giao diện sáng/tối" aria-label="Đổi giao diện sáng/tối">
                                <span id="sb-theme-icon">🌙</span>
                            </button>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                @await Component.InvokeAsync("NotificationBadge")
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-muted" asp-page="/Account/Profile">👤 @User.Identity!.Name</a>
                            </li>
                            <li class="nav-item">
                                <form asp-page="/Account/Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a asp-page="/Account/Register" class="btn btn-primary btn-sm ms-sm-2">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            © 2026 SplitBill — chia tiền minh bạch, không lăn tăn.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
