@page "{id:guid}"
@model SplitBill.Web.Pages.Groups.BalancesModel
@{
    ViewData["Title"] = "Số dư";
}

<h1>Số dư — @Model.Group.Name</h1>
<a asp-page="/Groups/Details" asp-route-id="@Model.Group.Id" class="btn btn-outline-secondary btn-sm mb-3">← Về nhóm</a>

<table class="table">
    <thead><tr><th>Thành viên</th><th class="text-end">Số dư</th></tr></thead>
    <tbody>
        @foreach (var balance in Model.Balances.OrderByDescending(b => b.Net))
        {
            <tr>
                <td>@balance.MemberName</td>
                <td class="text-end @(balance.Net > 0 ? "text-success" : balance.Net < 0 ? "text-danger" : "text-muted")">
                    @if (balance.Net > 0)
                    {
                        <text>Được nhận @balance.Net.ToString("N0")đ</text>
                    }
                    else if (balance.Net < 0)
                    {
                        <text>Còn nợ @Math.Abs(balance.Net).ToString("N0")đ</text>
                    }
                    else
                    {
                        <text>Đã cân bằng</text>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-page="/Groups/SettlementPlan" asp-route-id="@Model.Group.Id" class="btn btn-primary">Xem kế hoạch thanh toán</a>
