@page "{id:guid}"
@model SplitBill.Web.Pages.Groups.BalancesModel
@{
    ViewData["Title"] = "Số dư";
}

<a asp-page="/Groups/Details" asp-route-id="@Model.Group.Id" class="text-muted small">← @Localizer["Về nhóm"]</a>
<h1 class="mt-1">@Localizer["Số dư"] — @Model.Group.Name</h1>

<div class="row g-3 mt-1 mb-4">
    @foreach (var balance in Model.Balances.OrderByDescending(b => b.Net))
    {
        var cardClass = balance.Net > 0 ? "positive" : balance.Net < 0 ? "negative" : "";
        <div class="col-md-6 col-lg-4">
            <div class="sb-balance-card @cardClass">
                <span class="fw-600">@balance.MemberName</span>
                @if (balance.Net > 0)
                {
                    <span class="sb-amount-positive">+@SupportedCurrencies.Format(balance.Net, Model.Group.Currency)</span>
                }
                else if (balance.Net < 0)
                {
                    <span class="sb-amount-negative">@SupportedCurrencies.Format(balance.Net, Model.Group.Currency)</span>
                }
                else
                {
                    <span class="text-muted">@Localizer["Đã cân bằng"]</span>
                }
            </div>
        </div>
    }
</div>

<a asp-page="/Groups/SettlementPlan" asp-route-id="@Model.Group.Id" class="btn btn-primary">🔀 @Localizer["Xem kế hoạch thanh toán"]</a>
