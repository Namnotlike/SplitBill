@page "{id:guid}"
@model SplitBill.Web.Pages.Groups.BalancesModel
@{
    ViewData["Title"] = "Số dư";
}

<a asp-page="/Groups/Details" asp-route-id="@Model.Group.Id" class="text-muted small">← Về nhóm</a>
<h1 class="mt-1">Số dư — @Model.Group.Name</h1>

<div class="row g-3 mt-1 mb-4">
    @foreach (var balance in Model.Balances.OrderByDescending(b => b.Net))
    {
        var cardClass = balance.Net > 0 ? "positive" : balance.Net < 0 ? "negative" : "";
        <div class="col-md-6 col-lg-4">
            <div class="sb-balance-card @cardClass">
                <span class="fw-600">@balance.MemberName</span>
                @if (balance.Net > 0)
                {
                    <span class="sb-amount-positive">+@balance.Net.ToString("N0")đ</span>
                }
                else if (balance.Net < 0)
                {
                    <span class="sb-amount-negative">@balance.Net.ToString("N0")đ</span>
                }
                else
                {
                    <span class="text-muted">Đã cân bằng</span>
                }
            </div>
        </div>
    }
</div>

<a asp-page="/Groups/SettlementPlan" asp-route-id="@Model.Group.Id" class="btn btn-primary">🔀 Xem kế hoạch thanh toán</a>
