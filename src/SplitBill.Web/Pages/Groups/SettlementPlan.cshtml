@page "{id:guid}"
@model SplitBill.Web.Pages.Groups.SettlementPlanModel
@{
    ViewData["Title"] = "Kế hoạch thanh toán";
}

<a asp-page="/Groups/Details" asp-route-id="@Model.Group.Id" class="text-muted small">← @Localizer["Về nhóm"]</a>
<h1 class="mt-1 mb-4">@Localizer["Kế hoạch thanh toán"] — @Model.Group.Name</h1>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">✅ @ok</div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<h5 class="mb-3">
    @(Model.Plan.Simplified ? Localizer["🔀 Đề xuất gộp nợ tối ưu"] : Localizer["Nợ trực tiếp theo từng khoản chi"])
    <span class="text-muted fw-normal">— @Localizer["{0} giao dịch", Model.Plan.TransactionCount]</span>
</h5>

@if (Model.Plan.Transactions.Count == 0)
{
    <div class="card mb-4">
        <div class="card-body text-center py-5">
            <div class="fs-1 mb-2">🎉</div>
            <p class="text-muted mb-0">@Localizer["Mọi người đã cân bằng, không cần chuyển gì thêm."]</p>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var tx in Model.Plan.Transactions)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <p class="mb-1"><strong>@tx.FromName</strong> @Localizer["chuyển cho"] <strong>@tx.ToName</strong></p>
                        <p class="fs-4 fw-700 mb-2" style="color: var(--sb-brand-dark);">@SupportedCurrencies.Format(tx.Amount, Model.Group.Currency)</p>
                        @if (tx.VietQr is not null)
                        {
                            <div class="qr-canvas d-flex justify-content-center mb-2" data-payload="@tx.VietQr.Payload"></div>
                            <p class="small text-muted mb-0">@Localizer["Quét để chuyển khoản qua {0}", tx.VietQr.BankBin]</p>
                        }
                        else
                        {
                            <p class="small text-muted">@Localizer["{0} chưa khai báo tài khoản ngân hàng.", tx.ToName]</p>
                        }
                        @if (Model.MyMemberId == tx.FromMemberId)
                        {
                            <form method="post" asp-page-handler="Record" asp-route-id="@Model.Group.Id" class="mt-2">
                                <input type="hidden" name="NewSettlement.FromMemberId" value="@tx.FromMemberId" />
                                <input type="hidden" name="NewSettlement.ToMemberId" value="@tx.ToMemberId" />
                                <input type="hidden" name="NewSettlement.Amount" value="@tx.Amount" />
                                <button type="submit" class="btn btn-sm btn-primary">@Localizer["Tôi đã chuyển khoản này"]</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Localizer["Ghi nhận thanh toán khác"]</h5>
        <form method="post" asp-page-handler="Record" asp-route-id="@Model.Group.Id" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">@Localizer["Từ"]</label>
                <select name="NewSettlement.FromMemberId" class="form-select">
                    @foreach (var m in Model.Group.Members)
                    {
                        <option value="@m.Id">@m.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">@Localizer["Đến"]</label>
                <select name="NewSettlement.ToMemberId" class="form-select">
                    @foreach (var m in Model.Group.Members)
                    {
                        <option value="@m.Id">@m.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">@Localizer["Số tiền"] (@Model.Group.Currency)</label>
                <input name="NewSettlement.Amount" type="number" min="1" class="form-control" />
            </div>
            <div class="col-auto">
                <label class="form-label">@Localizer["Ghi chú"]</label>
                <input name="NewSettlement.Note" class="form-control" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">@Localizer["Ghi nhận"]</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body @(Model.Settlements.Count > 0 ? "p-0" : "")">
        <h5 class="card-title @(Model.Settlements.Count > 0 ? "px-4 pt-4" : "")">@Localizer["Lịch sử ghi nhận"]</h5>
        @if (Model.Settlements.Count == 0)
        {
            <p class="text-muted mb-0">@Localizer["Chưa có ghi nhận nào."]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th class="ps-4">@Localizer["Từ"]</th><th>@Localizer["Đến"]</th><th>@Localizer["Số tiền"]</th><th>@Localizer["Trạng thái"]</th><th class="pe-4"></th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Settlements)
                        {
                            <tr>
                                <td class="ps-4">@Model.MemberName(s.FromMemberId)</td>
                                <td>@Model.MemberName(s.ToMemberId)</td>
                                <td>@SupportedCurrencies.Format(s.Amount, Model.Group.Currency)</td>
                                <td>
                                    @{
                                        var badgeClass = s.Status switch
                                        {
                                            "Confirmed" => "bg-success",
                                            "Rejected" => "bg-danger",
                                            _ => "bg-warning text-dark",
                                        };
                                    }
                                    <span class="badge @badgeClass">@s.Status</span>
                                </td>
                                <td class="pe-4 text-end">
                                    @if (s.Status == "Pending" && Model.MyMemberId == s.ToMemberId)
                                    {
                                        <form method="post" asp-page-handler="Confirm" asp-route-id="@Model.Group.Id" asp-route-settlementId="@s.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success">@Localizer["Xác nhận"]</button>
                                        </form>
                                        <form method="post" asp-page-handler="Reject" asp-route-id="@Model.Group.Id" asp-route-settlementId="@s.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Từ chối"]</button>
                                        </form>
                                    }
                                    @if (s.Status == "Pending")
                                    {
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Group.Id" asp-route-settlementId="@s.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["Xóa"]</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        document.querySelectorAll('.qr-canvas').forEach(function (el) {
            try {
                new QRCode(el, { text: el.dataset.payload, width: 180, height: 180 });
            } catch (e) {
                el.textContent = '@Localizer["Không tải được mã QR."]';
                console.error(e);
            }
        });
    </script>
}
