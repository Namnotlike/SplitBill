@page
@model SplitBill.Web.Pages.Groups.IndexModel
@{
    ViewData["Title"] = "Nhóm của tôi";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1>@Localizer["Nhóm của tôi"]</h1>
        <p class="text-muted mb-4">@Localizer["Chọn 1 nhóm để xem chi tiết, hoặc tạo nhóm mới ở bên phải."]</p>
    </div>
    <a asp-page="/Groups/Templates" class="btn btn-outline-secondary">@Localizer["🗂️ Mẫu nhóm của tôi"]</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.MyGroups.Count == 0)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <div class="fs-1 mb-2">🗂️</div>
                    <p class="text-muted mb-0">@Localizer["Chưa có nhóm nào. Tạo nhóm đầu tiên ở bên phải 👉"]</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var group in Model.MyGroups)
                {
                    <div class="col-md-6">
                        <a asp-page="/Groups/Details" asp-route-id="@group.Id" class="card h-100 text-decoration-none">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0 text-body">@group.Name</h5>
                                    @if (group.IsArchived)
                                    {
                                        <span class="badge bg-secondary">@Localizer["Lưu trữ"]</span>
                                    }
                                </div>
                                <span class="badge" style="background: var(--sb-brand-light); color: var(--sb-brand-dark);">
                                    @(group.Type == "OneTime" ? Localizer["Một lần"] : Localizer["Dùng lại nhiều lần"])
                                </span>
                                <span class="badge bg-secondary">@group.Currency</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@Localizer["+ Tạo nhóm mới"]</h5>
                <form method="post" asp-page-handler="Create">
                    <div class="mb-3">
                        <label asp-for="NewGroup.Name" class="form-label">@Localizer["Tên nhóm"]</label>
                        <input asp-for="NewGroup.Name" class="form-control" placeholder="VD: Du lịch Đà Lạt" />
                        <span asp-validation-for="NewGroup.Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewGroup.Description" class="form-label">@Localizer["Mô tả (tùy chọn)"]</label>
                        <input asp-for="NewGroup.Description" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewGroup.Type" class="form-label">@Localizer["Loại nhóm"]</label>
                        <select asp-for="NewGroup.Type" class="form-select">
                            <option value="OneTime">@Localizer["Một lần (cuộc chơi)"]</option>
                            <option value="Recurring">@Localizer["Dùng lại nhiều lần"]</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewGroup.Currency" class="form-label">@Localizer["Tiền tệ"]</label>
                        <select asp-for="NewGroup.Currency" class="form-select">
                            <option value="VND">VND (đ)</option>
                            <option value="USD">USD ($)</option>
                            <option value="EUR">EUR (€)</option>
                        </select>
                        <span class="text-muted small">@Localizer["Không đổi được sau khi đã tạo nhóm."]</span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@Localizer["Tạo nhóm"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
