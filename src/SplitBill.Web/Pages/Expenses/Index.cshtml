@page "{groupId:guid}"
@model SplitBill.Web.Pages.Expenses.IndexModel
@{
    ViewData["Title"] = "Khoản chi";
}

<a asp-page="/Groups/Details" asp-route-id="@Model.GroupId" class="text-muted small">← Về nhóm</a>
<div class="d-flex justify-content-between align-items-center mt-1 mb-4 flex-wrap gap-2">
    <h1 class="mb-0">Khoản chi — @Model.Group.Name</h1>
    <a asp-page="/Expenses/Create" asp-route-groupId="@Model.GroupId" class="btn btn-primary">+ Thêm khoản chi</a>
</div>

@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">✅ @ok</div>
}

@if (Model.Expenses.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <div class="fs-1 mb-2">🧾</div>
            <p class="text-muted mb-0">Chưa có khoản chi nào.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Ngày</th>
                        <th>Tiêu đề</th>
                        <th>Tổng tiền</th>
                        <th>Ai ứng</th>
                        <th>Chia theo</th>
                        <th class="pe-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model.Expenses.Items)
                    {
                        <tr>
                            <td class="ps-4 text-muted">@expense.OccurredAt.ToString("dd/MM/yyyy")</td>
                            <td class="fw-600">@expense.Title</td>
                            <td>@SupportedCurrencies.Format(expense.TotalAmount, Model.Group.Currency)</td>
                            <td>@string.Join(", ", expense.Payers.Select(p => Model.MemberName(p.MemberId)))</td>
                            <td><span class="badge" style="background: var(--sb-brand-light); color: var(--sb-brand-dark);">@expense.SplitMode</span></td>
                            <td class="pe-4 text-end">
                                <a asp-page="/Expenses/Edit" asp-route-expenseId="@expense.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                                <form method="post" asp-page-handler="Delete" asp-route-expenseId="@expense.Id" asp-route-groupId="@Model.GroupId" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-muted small mt-3">Trang @Model.Expenses.Page — tổng @Model.Expenses.TotalCount khoản chi.</p>
}
