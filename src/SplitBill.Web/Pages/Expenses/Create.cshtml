@page "{groupId:guid}"
@model SplitBill.Web.Pages.Expenses.CreateModel
@{
    ViewData["Title"] = "Thêm khoản chi";
}

<a asp-page="/Expenses/Index" asp-route-groupId="@Model.GroupId" class="text-muted small">← Khoản chi</a>
<h1 class="mt-1 mb-4">Thêm khoản chi — @Model.Group.Name</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

<div class="card">
    <div class="card-body p-4">
        <form method="post">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.Title" class="form-label">Tiêu đề</label>
                    <input asp-for="Input.Title" class="form-control" placeholder="VD: Ăn tối" autofocus />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Input.TotalAmount" class="form-label">Tổng tiền (@Model.Group.Currency)</label>
                    <input asp-for="Input.TotalAmount" class="form-control" type="number" min="1" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Input.ExtraFeeAmount" class="form-label">Phụ phí (@Model.Group.Currency)</label>
                    <input asp-for="Input.ExtraFeeAmount" class="form-control" type="number" min="0" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Input.OccurredAt" class="form-label">Thời gian</label>
                    <input asp-for="Input.OccurredAt" class="form-control" type="datetime-local" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-8 mb-4">
                    <label asp-for="Input.Note" class="form-label">Ghi chú</label>
                    <input asp-for="Input.Note" class="form-control" />
                </div>
                <div class="col-md-4 mb-4">
                    <label asp-for="Input.Category" class="form-label">Danh mục</label>
                    <select asp-for="Input.Category" class="form-select">
                        @foreach (var category in ExpenseCategoryOptions.All)
                        {
                            <option value="@category.Value">@category.Icon @category.Label</option>
                        }
                    </select>
                </div>
            </div>

            @* ===== Preset cách chia hay dùng (CLAUDE.md mục 21) ===== *@
            @if (Model.Presets.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label d-block">📁 Preset đã lưu</label>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        @foreach (var preset in Model.Presets)
                        {
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary apply-preset-btn" data-preset-id="@preset.Id">@preset.Name</button>
                                <button type="submit" formaction="?handler=DeletePreset&amp;presetId=@preset.Id" formnovalidate
                                        class="btn btn-outline-secondary" title="Xóa preset này">×</button>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mb-3 d-flex gap-2 align-items-end flex-wrap">
                <div>
                    <label for="preset-name-input" class="form-label small mb-1">Lưu cách chia hiện tại thành preset</label>
                    <input type="text" id="preset-name-input" name="PresetName" class="form-control form-control-sm"
                           placeholder="VD: Tôi & Bình chia đôi" style="min-width: 260px;" />
                </div>
                <button type="submit" formaction="?handler=SavePreset" formnovalidate class="btn btn-sm btn-outline-primary">💾 Lưu thành preset</button>
            </div>

            <div class="mb-4">
                <label class="form-label d-block">Cách chia</label>
                @{
                    var modes = new[] { ("Equal", "Chia đều"), ("Shares", "Theo phần"), ("Percentage", "Theo %"), ("ExactAmount", "Nhập tay"), ("Itemized", "Theo món") };
                }
                <div class="btn-group flex-wrap" role="group">
                    @foreach (var (value, label) in modes)
                    {
                        <input type="radio" class="btn-check split-mode-radio" name="Input.SplitMode" id="mode-@value" value="@value" autocomplete="off"
                               checked="@(Model.Input.SplitMode == value)" />
                        <label class="btn btn-outline-primary" for="mode-@value">@label</label>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Thành viên</th>
                            <th>Đã ứng (@Model.Group.Currency)</th>
                            <th class="split-col" data-mode="Equal">Tham gia?</th>
                            <th class="split-col" data-mode="Shares">Trọng số</th>
                            <th class="split-col" data-mode="Percentage">%</th>
                            <th class="split-col" data-mode="ExactAmount">Số tiền (@Model.Group.Currency)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Input.Rows.Count; i++)
                        {
                            var member = Model.Group.Members.First(m => m.Id == Model.Input.Rows[i].MemberId);
                            <tr>
                                <td class="fw-600">
                                    @member.DisplayName
                                    <input type="hidden" asp-for="Input.Rows[i].MemberId" />
                                </td>
                                <td><input asp-for="Input.Rows[i].PayerAmount" class="form-control form-control-sm" type="number" min="0" /></td>
                                <td class="split-col" data-mode="Equal">
                                    <input asp-for="Input.Rows[i].EqualParticipant" class="form-check-input" type="checkbox" />
                                </td>
                                <td class="split-col" data-mode="Shares">
                                    <input asp-for="Input.Rows[i].ShareWeight" class="form-control form-control-sm" type="number" min="0" step="0.1" />
                                </td>
                                <td class="split-col" data-mode="Percentage">
                                    <input asp-for="Input.Rows[i].Percentage" class="form-control form-control-sm" type="number" min="0" max="100" step="0.1" />
                                </td>
                                <td class="split-col" data-mode="ExactAmount">
                                    <input asp-for="Input.Rows[i].ExactAmount" class="form-control form-control-sm" type="number" min="0" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="split-col mb-3" data-mode="Itemized">
                <label class="form-label d-block">Món ăn</label>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th style="width: 25%">Tên món</th>
                                <th style="width: 15%">Giá (@Model.Group.Currency)</th>
                                <th>Người ăn</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="items-tbody"></tbody>
                    </table>
                </div>
                <button type="button" id="add-item-btn" class="btn btn-sm btn-secondary">+ Thêm món</button>
            </div>

            <template id="item-row-template">
                <tr class="item-row">
                    <td>
                        <input type="hidden" name="Input.Items.Index" value="__INDEX__" />
                        <input name="Input.Items[__INDEX__].Name" class="form-control form-control-sm item-name-input" placeholder="VD: Lẩu" />
                    </td>
                    <td>
                        <input name="Input.Items[__INDEX__].Price" type="number" min="0" class="form-control form-control-sm item-price-input" />
                    </td>
                    <td>
                        @foreach (var member in Model.Group.Members)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input item-consumer-checkbox" type="checkbox" name="Input.Items[__INDEX__].ConsumerMemberIds" value="@member.Id" id="item__INDEX__-@member.Id" />
                                <label class="form-check-label" for="item__INDEX__-@member.Id">@member.DisplayName</label>
                            </div>
                        }
                    </td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger remove-item-row">Xóa</button></td>
                </tr>
            </template>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Lưu khoản chi</button>
                <a asp-page="/Expenses/Index" asp-route-groupId="@Model.GroupId" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function updateSplitColumns() {
            var mode = document.querySelector('.split-mode-radio:checked').value;
            document.querySelectorAll('.split-col').forEach(function (el) {
                el.style.display = el.dataset.mode === mode ? '' : 'none';
            });
        }
        document.querySelectorAll('.split-mode-radio').forEach(function (el) {
            el.addEventListener('change', updateSplitColumns);
        });
        updateSplitColumns();

        var itemIndexCounter = 0;
        var itemTemplateHtml = document.getElementById('item-row-template').innerHTML;
        function addItemRow() {
            var idx = 'i' + (itemIndexCounter++);
            var html = itemTemplateHtml.split('__INDEX__').join(idx);
            var tbody = document.getElementById('items-tbody');
            tbody.insertAdjacentHTML('beforeend', html);
            attachRemoveHandlers();
            return tbody.lastElementChild;
        }
        function attachRemoveHandlers() {
            document.querySelectorAll('.remove-item-row').forEach(function (btn) {
                btn.onclick = function () { btn.closest('tr').remove(); };
            });
        }
        document.getElementById('add-item-btn').addEventListener('click', addItemRow);
        addItemRow(); // sẵn 1 dòng trống để bắt đầu

        // ===== Preset cách chia hay dùng (CLAUDE.md mục 21) — áp dụng preset là thao tác THUẦN
        // CLIENT-SIDE (không round-trip server): điền lại đúng các input Rows/Items đã render sẵn
        // theo dữ liệu preset, dùng chung cấu trúc DOM/tên input với form chính. =====
        var presets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Presets.Select(p => new { id = p.Id, splitMode = p.SplitMode, splitConfig = p.SplitConfig }),
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        function rowForMember(memberId) {
            var hidden = Array.from(document.querySelectorAll('input[name$=".MemberId"]'))
                .find(function (h) { return h.value === memberId; });
            return hidden ? hidden.closest('tr') : null;
        }

        function applyPreset(presetId) {
            var preset = presets.find(function (p) { return p.id === presetId; });
            if (!preset) {
                return;
            }

            var modeRadio = document.getElementById('mode-' + preset.splitMode);
            if (modeRadio) {
                modeRadio.checked = true;
            }
            updateSplitColumns();

            // Reset toàn bộ giá trị chia cũ trước khi điền lại theo preset — tránh sót giá trị của
            // chế độ chia trước đó lẫn vào.
            document.querySelectorAll('[name$=".EqualParticipant"]').forEach(function (cb) { cb.checked = false; });
            document.querySelectorAll('[name$=".ShareWeight"]').forEach(function (i) { i.value = ''; });
            document.querySelectorAll('[name$=".Percentage"]').forEach(function (i) { i.value = ''; });
            document.querySelectorAll('[name$=".ExactAmount"]').forEach(function (i) { i.value = ''; });

            var config = preset.splitConfig || {};
            (config.memberIds || []).forEach(function (id) {
                var row = rowForMember(id);
                if (row) { row.querySelector('[name$=".EqualParticipant"]').checked = true; }
            });
            (config.shares || []).forEach(function (s) {
                var row = rowForMember(s.memberId);
                if (row) { row.querySelector('[name$=".ShareWeight"]').value = s.weight; }
            });
            (config.percentages || []).forEach(function (p) {
                var row = rowForMember(p.memberId);
                if (row) { row.querySelector('[name$=".Percentage"]').value = p.percent; }
            });
            (config.exactAmounts || []).forEach(function (e) {
                var row = rowForMember(e.memberId);
                if (row) { row.querySelector('[name$=".ExactAmount"]').value = e.amount; }
            });

            // Món ăn (Itemized) — xóa hết dòng cũ rồi dựng lại đúng theo preset, cùng mẫu khôi phục
            // đã dùng ở Expenses/Edit.cshtml (mục 4.1, SplitConfigJson).
            document.getElementById('items-tbody').innerHTML = '';
            var items = config.items || [];
            if (items.length > 0) {
                items.forEach(function (item) {
                    var row = addItemRow();
                    row.querySelector('.item-name-input').value = item.name;
                    row.querySelector('.item-price-input').value = item.price;
                    (item.consumerMemberIds || []).forEach(function (memberId) {
                        var checkbox = row.querySelector('.item-consumer-checkbox[value="' + memberId + '"]');
                        if (checkbox) { checkbox.checked = true; }
                    });
                });
            } else {
                addItemRow(); // giữ đúng hành vi "luôn có 1 dòng trống" nếu preset không phải Itemized
            }
        }

        document.querySelectorAll('.apply-preset-btn').forEach(function (btn) {
            btn.addEventListener('click', function () { applyPreset(btn.dataset.presetId); });
        });
    </script>
}
