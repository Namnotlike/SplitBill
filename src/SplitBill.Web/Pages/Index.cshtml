@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="text-center py-5 py-md-6">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4"
         style="width: 88px; height: 88px; background: var(--sb-brand-light); font-size: 2.5rem;">
        💰
    </div>
    <h1 class="display-5 fw-800 mb-3">@Localizer["Chia tiền nhóm, khỏi cần tính nhẩm"]</h1>
    <p class="lead text-muted mx-auto mb-4" style="max-width: 560px;">
        @Localizer["Ai ứng bao nhiêu, ai chịu bao nhiêu, cuối cùng ai chuyển cho ai — SplitBill tự tính hết, kèm mã VietQR quét phát chuyển luôn."]
    </p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Groups/Index" class="btn btn-primary btn-lg px-4">@Localizer["Xem nhóm của tôi"]</a>
    }
    else
    {
        <a asp-page="/Account/Register" class="btn btn-primary btn-lg px-4 me-2">@Localizer["Bắt đầu miễn phí"]</a>
        <a asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg px-4">@Localizer["Đăng nhập"]</a>
    }
</div>

@* ===== Bảng tổng quan cá nhân (CLAUDE.md mục 15.4) — bổ sung 2026-09-05. Không cộng gộp Net giữa
   các nhóm vì mỗi nhóm có thể khác đơn vị tiền tệ (mục 14) — hiển thị riêng từng dòng. ===== *@
@if (User.Identity?.IsAuthenticated == true && Model.MyOverview.Count > 0)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">@Localizer["Tổng quan số dư của bạn"]</h5>
            <div class="row g-3">
                @foreach (var item in Model.MyOverview.OrderByDescending(o => o.Net))
                {
                    <div class="col-md-4">
                        <a asp-page="/Groups/Balances" asp-route-id="@item.GroupId" class="sb-balance-card @(item.Net > 0 ? "positive" : item.Net < 0 ? "negative" : "") text-decoration-none d-block">
                            <div>
                                <div class="fw-600" style="color: var(--sb-ink);">@item.GroupName</div>
                                <div class="small text-muted">
                                    @(item.Net > 0 ? Localizer["Được nhận"] : item.Net < 0 ? Localizer["Còn nợ"] : Localizer["Đã cân bằng"])
                                </div>
                            </div>
                            <div class="@(item.Net > 0 ? "sb-amount-positive" : item.Net < 0 ? "sb-amount-negative" : "fw-700")">
                                @SupportedCurrencies.Format(Math.Abs(item.Net), item.Currency)
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ===== "Ai đang nợ tôi" xuyên nhóm (CLAUDE.md mục 20) — bổ sung 2026-09-07. Gộp theo TỪNG NGƯỜI
   (khác widget trên gộp theo từng nhóm). Chỉ hiện counterparty có tài khoản (khách vãng lai không có
   danh tính ổn định xuyên nhóm). KHÔNG cộng gộp số tiền giữa các nhóm khác tiền tệ — mỗi nhóm 1 dòng
   riêng trong cùng 1 thẻ người. ===== *@
@if (User.Identity?.IsAuthenticated == true && Model.CounterpartyBalances.Count > 0)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">@Localizer["Ai đang nợ bạn / bạn đang nợ ai"]</h5>
            <div class="row g-3">
                @foreach (var person in Model.CounterpartyBalances)
                {
                    <div class="col-md-6">
                        <div class="sb-balance-card d-block">
                            <div class="w-100">
                                <div class="fw-600 mb-1" style="color: var(--sb-ink);">@person.CounterpartyDisplayName</div>
                                @foreach (var g in person.Groups)
                                {
                                    <div class="d-flex justify-content-between small">
                                        <a asp-page="/Groups/SettlementPlan" asp-route-id="@g.GroupId" class="text-muted text-decoration-none">@g.GroupName</a>
                                        <span class="@(g.Amount > 0 ? "sb-amount-positive" : "sb-amount-negative")">
                                            @(g.Amount > 0 ? Localizer["Nợ bạn "] : Localizer["Bạn nợ "])@SupportedCurrencies.Format(Math.Abs(g.Amount), g.Currency)
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ===== Dashboard cá nhân nâng cao (CLAUDE.md mục 25.5) — bổ sung 2026-09-09. Khác 2 widget trên: trả
   lời "có gì cần tôi xử lý ngay" (settlement đang chờ mình xác nhận) và "gần đây có gì mới xuyên mọi
   nhóm" (hoạt động gộp từ Timeline từng nhóm), không phải số dư. ===== *@
@if (User.Identity?.IsAuthenticated == true && Model.Dashboard is { TotalActiveGroups: > 0 } dashboard)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">@Localizer["Dashboard cá nhân"]</h5>
            <div class="row g-3 mb-3">
                <div class="col-4">
                    <div class="text-muted small">@Localizer["Nhóm đang tham gia"]</div>
                    <div class="fs-4 fw-700">@dashboard.TotalActiveGroups</div>
                </div>
                <div class="col-4">
                    <div class="text-muted small">@Localizer["Khoản chi tháng này"]</div>
                    <div class="fs-4 fw-700">@dashboard.ExpensesThisMonth</div>
                </div>
                <div class="col-4">
                    <div class="text-muted small">@Localizer["Chờ bạn xác nhận"]</div>
                    <div class="fs-4 fw-700">@dashboard.PendingSettlementsToConfirm.Count</div>
                </div>
            </div>

            @if (dashboard.PendingSettlementsToConfirm.Count > 0)
            {
                <h6>@Localizer["Cần bạn xác nhận"]</h6>
                <ul class="list-unstyled mb-3">
                    @foreach (var s in dashboard.PendingSettlementsToConfirm)
                    {
                        <li class="d-flex justify-content-between small mb-1">
                            <a asp-page="/Groups/SettlementPlan" asp-route-id="@s.GroupId" class="text-muted text-decoration-none">
                                @s.FromMemberName → @s.GroupName
                            </a>
                            <span class="fw-600">@SupportedCurrencies.Format(s.Amount, s.Currency)</span>
                        </li>
                    }
                </ul>
            }

            @if (dashboard.RecentActivity.Count > 0)
            {
                <h6>@Localizer["Hoạt động gần đây"]</h6>
                <ul class="list-unstyled mb-0">
                    @foreach (var a in dashboard.RecentActivity)
                    {
                        <li class="small text-muted mb-1">
                            <a asp-page="/Groups/Timeline" asp-route-id="@a.GroupId" class="text-decoration-none">@a.GroupName</a>
                            — @a.Summary
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 mb-2">🧾</div>
                <h5 class="card-title">@Localizer["Nhiều cách chia"]</h5>
                <p class="text-muted mb-0">@Localizer["Chia đều, theo phần, theo %, nhập tay, hoặc theo từng món ăn — làm tròn luôn công bằng."]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 mb-2">🔀</div>
                <h5 class="card-title">@Localizer["Gộp nợ tối ưu"]</h5>
                <p class="text-muted mb-0">@Localizer["Thuật toán tự tìm số lượt chuyển khoản ít nhất, không ai phải chuyển vòng vo qua người khác."]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="fs-2 mb-2">📱</div>
                <h5 class="card-title">@Localizer["Quét QR chuyển ngay"]</h5>
                <p class="text-muted mb-0">@Localizer["Mỗi khoản cần chuyển đều kèm mã VietQR — mở app ngân hàng quét là xong, khỏi gõ số tài khoản."]</p>
            </div>
        </div>
    </div>
</div>
