@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="text-center py-5">
    <h1 class="display-4">💰 SplitBill</h1>
    <p class="lead">Chia tiền cho nhóm bạn — ai ứng, ai chịu, ai còn nợ ai.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Groups/Index" class="btn btn-primary btn-lg mt-3">Xem nhóm của tôi</a>
    }
    else
    {
        <a asp-page="/Account/Register" class="btn btn-primary btn-lg mt-3">Bắt đầu ngay</a>
        <a asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg mt-3">Đăng nhập</a>
    }
</div>
