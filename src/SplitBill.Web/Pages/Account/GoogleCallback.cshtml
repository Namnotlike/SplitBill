@page
@model SplitBill.Web.Pages.Account.GoogleCallbackModel
@{
    ViewData["Title"] = "Đăng nhập bằng Google";
}

<div class="card sb-auth-card">
    <div class="card-body p-4">
        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
            <p class="text-center mb-0">
                <a asp-page="/Account/Login" class="btn btn-primary">@Localizer["Quay lại đăng nhập"]</a>
            </p>
        }
        else
        {
            <p class="text-center mb-0">@Localizer["Đang xử lý đăng nhập..."]</p>
        }
    </div>
</div>
