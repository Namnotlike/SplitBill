@page
@model SplitBill.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="card sb-auth-card">
    <div class="card-body p-4">
        <h1 class="h3 text-center mb-1">@Localizer["Đặt lại mật khẩu"]</h1>
        <p class="text-muted text-center mb-4">@Localizer["Nhập mật khẩu mới cho tài khoản của bạn"]</p>

        @if (Model.Succeeded)
        {
            <div class="alert alert-success">
                @Localizer["Đổi mật khẩu thành công. Mọi phiên đăng nhập khác đã bị đăng xuất — hãy đăng nhập lại bằng mật khẩu mới."]
            </div>
            <p class="text-center mb-0">
                <a asp-page="/Account/Login" class="btn btn-primary w-100">@Localizer["Đăng nhập ngay"]</a>
            </p>
        }
        else
        {
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Token))
            {
                <form method="post">
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label">@Localizer["Mật khẩu mới"]</label>
                        <input asp-for="Input.NewPassword" type="password" class="form-control" autofocus />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label">@Localizer["Xác nhận mật khẩu mới"]</label>
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@Localizer["Đặt lại mật khẩu"]</button>
                </form>
            }
            else
            {
                <p class="text-center mb-0">
                    <a asp-page="/Account/ForgotPassword">@Localizer["Yêu cầu link đặt lại mật khẩu mới"]</a>
                </p>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
