@page
@model TwoFactorChallengeModel
@{
    ViewData["Title"] = "Xác thực 2 lớp";
}

<div class="card sb-auth-card">
    <div class="card-body p-4">
        <h1 class="h3 text-center mb-1">🔐 Xác thực 2 lớp</h1>
        <p class="text-muted text-center mb-4">Mở app xác thực (Google Authenticator, Authy...) và nhập mã 6 chữ số hiện tại, hoặc dùng 1 mã dự phòng nếu không còn quyền truy cập app.</p>

        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Code" class="form-label">Mã xác thực</label>
                <input asp-for="Code" class="form-control form-control-lg text-center" style="letter-spacing: 0.3em;"
                       inputmode="numeric" autocomplete="one-time-code" autofocus maxlength="12" placeholder="000000" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-3">Xác nhận</button>
            <p class="text-center text-muted mb-0">
                <a asp-page="/Account/Login">← Quay lại đăng nhập</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
