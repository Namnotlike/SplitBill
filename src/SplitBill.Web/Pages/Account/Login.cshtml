@page
@model SplitBill.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="card sb-auth-card">
    <div class="card-body p-4">
        <h1 class="h3 text-center mb-1">@Localizer["Chào mừng trở lại 👋"]</h1>
        <p class="text-muted text-center mb-4">@Localizer["Đăng nhập để xem nhóm của bạn"]</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">@Localizer["Email"]</label>
                <input asp-for="Input.Email" class="form-control" autofocus />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <label asp-for="Input.Password" class="form-label">@Localizer["Mật khẩu"]</label>
                <input asp-for="Input.Password" type="password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <p class="text-end mb-3">
                <a asp-page="/Account/ForgotPassword" class="text-muted">@Localizer["Quên mật khẩu?"]</a>
            </p>
            <button type="submit" class="btn btn-primary w-100 mb-3">@Localizer["Đăng nhập"]</button>
            <p class="text-center text-muted mb-0">
                @Localizer["Chưa có tài khoản?"] <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Đăng ký ngay"]</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
