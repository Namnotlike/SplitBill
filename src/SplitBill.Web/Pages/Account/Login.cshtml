@page
@model SplitBill.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<h1>Đăng nhập</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                <input asp-for="Input.Password" type="password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Đăng nhập</button>
            <a asp-page="/Account/Register" class="btn btn-link">Chưa có tài khoản? Đăng ký</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
